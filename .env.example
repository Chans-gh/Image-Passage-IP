# Image-Passage 配置示例
# 复制为 .env，放在你的工作目录（运行 Agent 的目录）或 image-passage-work/ 下。
# .env 只保存在你自己的电脑上，不要提交到任何仓库。

# ── 渲染模式 ───────────────────────────────────────────
# auto   ：自动判断（默认）。有原生生图工具用 native；否则用 svg；
#          配置了下面的图片 API 且用户选择时用 api
# native ：使用当前 Agent 环境自带的生图工具
# svg    ：HTML/SVG 排版后渲染为 PNG（不需要任何生图能力）
# api    ：调用下面配置的图片 API
RENDER_MODE=auto

# ── 图片 API（仅 api 模式需要）──────────────────────────
# 默认按 OpenAI 兼容格式调用：
#   文生图  POST {BASE_URL}/images/generations
#   参考图  POST {BASE_URL}/images/edits   （multipart，image[] 字段）
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_API_MODEL=
# 接口支持的尺寸。生成后会自动适配为 3:4（1242×1656）
IMAGE_API_SIZE=1024x1536
# 参考图（P1、角色资产、素材）的传递方式：edits | none
IMAGE_API_REFERENCE_MODE=edits
# 可选：quality 参数，接口不支持就留空
IMAGE_API_QUALITY=

# ── 语音转写（可选，用于音频和视频输入）──────────────────
# OpenAI 兼容格式：POST {BASE_URL}/audio/transcriptions
TRANSCRIBE_API_BASE_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_API_MODEL=

# ── 输出规格（平台预设可覆盖）────────────────────────────
OUTPUT_WIDTH=1242
OUTPUT_HEIGHT=1656

# ── 路径（可选）─────────────────────────────────────────
# 工作区目录，默认是当前目录下的 image-passage-work/
IMAGE_PASSAGE_WORKDIR=
# 字体缓存目录，默认是 ~/.cache/image-passage/fonts
IMAGE_PASSAGE_FONT_DIR=
